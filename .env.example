# Copy to .env and fill in. Nothing here is required: with an empty file Vigil runs
# end-to-end on the deterministic mock backends, and every command below works.
# Only VIGIL_NEBIUS_API_KEY turns a mock run into a real one.

# ── Nebius Token Factory (required for a hackathon-eligible live run) ──────────────
# Create a key at console.nebius.com -> API Keys. .gitignore excludes .env; never commit it.
VIGIL_NEBIUS_API_KEY=
VIGIL_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Leave both model IDs EMPTY to auto-pick from GET /v1/models. That is the recommended
# setting: Nemotron-3 Super/Ultra are text-only, so a hard-coded vision model ID is the
# classic way to lose an afternoon. Set them explicitly only once you have seen the list
# from `vigil probe`.
VIGIL_REASONING_MODEL=
VIGIL_VISION_MODEL=
VIGIL_PREFER_NVIDIA_VISION=true

# ── Backend selection: auto | mock | nebius | cosmos ───────────────────────────────
# auto resolves to nebius when a key is present, otherwise mock.
VIGIL_PERCEPTION_BACKEND=auto
VIGIL_REASONING_BACKEND=auto
# Fake per-call latency in ms so the agent trace animates in a demo. 0 in tests.
VIGIL_MOCK_LATENCY_MS=0

# ── Free-credit guard ─────────────────────────────────────────────────────────────
# One investigation refuses to spend past these ceilings. The trial credit is $1, so
# defaults are set for roughly ten investigations, not one.
VIGIL_TOKEN_BUDGET=60000
VIGIL_USD_BUDGET=0.10
VIGIL_MAX_ITERATIONS=8
VIGIL_TEMPERATURE=0.2
VIGIL_MAX_OUTPUT_TOKENS=1200
VIGIL_REQUEST_TIMEOUT_S=120
VIGIL_MAX_RETRIES=2

# Rates are gated behind the console, so Vigil's USD figures are estimates. Override with
# what you actually pay: {"nvidia/nemotron-3-super": [0.30, 0.90]}
# VIGIL_MODEL_PRICES=

# ── Local NVIDIA Cosmos Reason (optional; EXPERIMENTAL, needs a CUDA GPU with ~9 GB free) ─
# Gated model: accept the licence on huggingface.co and run 'huggingface-cli login' first.
# Quantising also needs bitsandbytes, which the [cosmos] extra installs.
VIGIL_COSMOS_MODEL_ID=nvidia/Cosmos-Reason2-2B
VIGIL_COSMOS_DEVICE=cuda
VIGIL_COSMOS_QUANTIZE=4bit

# ── Video sampling ────────────────────────────────────────────────────────────────
VIGIL_CLIP_SECONDS=4.0
VIGIL_FRAMES_PER_CLIP=6
VIGIL_FRAME_MAX_PX=512
VIGIL_MAX_CLIPS_PER_VIDEO=8
VIGIL_CACHE_DIR=artifacts/cache

# ── Paths ─────────────────────────────────────────────────────────────────────────
VIGIL_DATA_DIR=data
VIGIL_ARTIFACT_DIR=artifacts
VIGIL_POLICY_DIR=data/policy
VIGIL_CLIP_DIR=data/clips

# ── Presentation ──────────────────────────────────────────────────────────────────
VIGIL_SITE_NAME=Northgate Logistics -- Bay 3
VIGIL_LOCALE=en
VIGIL_LOG_LEVEL=INFO
